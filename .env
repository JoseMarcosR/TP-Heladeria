# Valores de DESARROLLO. Docker Compose lee este archivo automáticamente.

# PostgreSQL
DB_NAME=heladeria
DB_USER=heladeria
DB_PASSWORD=heladeria
DB_PORT=5432

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Debe coincidir con el "iss" de los tokens (la URL con la que el cliente llega a Keycloak)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/heladeria

# Solo ms-logistica. OSRM no necesita API key.
# - Por defecto usa el servidor público de demostración: https://router.project-osrm.org
# - Para OSRM local en modo híbrido (servicio Java en el IDE + OSRM en Docker): OSRM_URL=http://localhost:5000
# - Para OSRM local con todo en Docker (--profile apps --profile osrm): OSRM_URL=http://osrm:5000
# OSRM_URL=http://localhost:5000
# OSRM_PORT=5000